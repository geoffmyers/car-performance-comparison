# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw data sources (large datasets not needed in repo)
# Keep only the final merged output files (car-performance-data.csv, car-performance-data.db)
public/data/dvm-car/
public/data/fuel-economy-gov/
public/data/github/
public/data/kaggle/

# Large URL lists and intermediate files
public/data/**/car-review-urls-*.txt
public/data/**/raw/
public/data/**/*.html
